let state: State = initial;
const listeners = new Set<() => void>();

let viewCache: StoreView | null = null;
function view(s: State): StoreView {
  if (viewCache && viewCache.gymUsers === s.gymUsers && viewCache.gymPackages === s.gymPackages) {
    if (
      viewCache.activity === s.activity &&
      viewCache.students === s.students &&
      viewCache.integrations === s.integrations &&
      viewCache.telemetry_kpis === s.telemetry_kpis &&
      viewCache.taskQueueConfig === s.taskQueueConfig
    )
      return viewCache;
    viewCache = { ...s, gymMembers: viewCache.gymMembers, activity_logs: s.activity };
    return viewCache;
  }
  viewCache = { ...s, gymMembers: s.gymUsers.map((u) => toMember(u, s)), activity_logs: s.activity };
  return viewCache;
}

function emit() {
  listeners.forEach((l) => l());
}

function pushActivity(ev: Omit<ActivityEvent, "id" | "at">) {
  state = {
    ...state,
    activity: [
      { ...ev, id: uuid(), at: toUtcTimestamp() },
      ...state.activity,
    ].slice(0, 40),
  };
}

export const store = {
  get: () => view(state),
  /** Multi-tenant safety: wipes every gym ledger back to an empty tenant. */
  reset: () => {
    state = {
      ...initial,
      gymPackages: [],
      gymUsers: [],
      students: [],
      activity: [],
      daily_collections_chart: [],
    };
    viewCache = null;
    emit();
  },
  raw: () => state,
  subscribe: (l: () => void) => {
    listeners.add(l);
    return () => listeners.delete(l);
  },
  metrics: () => getDashboardMetrics(state),
  addGymPackage: (p: { name: string; fee: number; days: number }) => {
    state = {
      ...state,
      gymPackages: [...state.gymPackages, pkg(uuid(), p.name, p.fee, p.days)],
    };
    emit();
  },
  /** Soft delete — historical ledger math stays intact. */
  archiveGymPackage: (id: string) => {
    state = {
      ...state,
      gymPackages: state.gymPackages.map((p) => (p.id === id ? { ...p, is_archived: true } : p)),
    };
    emit();
  },
  restoreGymPackage: (id: string) => {
    state = {
      ...state,
      gymPackages: state.gymPackages.map((p) => (p.id === id ? { ...p, is_archived: false } : p)),
    };
    emit();
  },
  addGymMember: (m: {
    name: string;
    phone: string;
    packageId: string;
    packageName: string;
    fee: number;
    expiry: string;
  }) => {
    const parsed = addGymMemberSchema.safeParse({
      name: m.name,
      phone: m.phone,
      packageId: m.packageId,
      fee: m.fee,
      expiry: m.expiry,
    });
    if (!parsed.success) {
      toast.error(firstIssue(parsed.error));
      return { ok: false as const, error: firstIssue(parsed.error) };
    }
    const id = uuid();
    const p = getPackage(state, m.packageId);
    const duration = p?.duration_days ?? 30;
    const activation = toCalendarDate(addDays(new Date(parseCalendarDate(m.expiry)), -duration));
    const user: Member = {
      id,
      node_id: state.current_node_id,
      full_name: m.name,
      phone_number: m.phone,
      package_id: m.packageId,
      activation_date: activation,
      suspension_days_accrued: 0,
      lifecycle_status: "active",
      subscription_history: [
        {
          id: uuid(),
          user_id: id,
          package_id: m.packageId,
          package_name: p?.name ?? m.packageName,
          invoiced_amount: Math.round(p?.price ?? m.fee),
          liquidated_amount: Math.round(p?.price ?? m.fee),
          billing_period_start: activation,
          billing_period_end: toCalendarDate(m.expiry),
          status: "staged",
          idempotency_key: uuid(),
          version_lock: 1,
          payment_method: "cash",
        },
      ],
    };
    state = { ...state, gymUsers: [...state.gymUsers, user] };
    pushActivity({
      memberId: id,
      kind: "member_added",
      message: `New member enrolled: ${m.name} on ${m.packageName}`,
    });
    emit();
    return { ok: true as const, id };
  },

  /* ---------------- Server-side aggregation seam ---------------- */

  /** Stand-in for a single backend SQL aggregate over the whole tenant. */
  fetchGlobalTelemetry: async (): Promise<GymTelemetryKpis> => {
    state = { ...state, telemetry_kpis: { ...state.telemetry_kpis, is_syncing: true } };
    emit();
    await simulateApiRead(220);
    state = { ...state, telemetry_kpis: { ...aggregateGymRows(state), synced_at: toUtcTimestamp(), is_syncing: false, isLoadingTelemetry: false } };
    emit();
    return state.telemetry_kpis;
  },

  /**
   * Anti-harassment / anti-double-charge pre-flight: has an async gateway
   * webhook already settled this member's current cycle?
   */
  verifyMemberFreshness: async (member_id: string): Promise<boolean> => {
    await simulateApiRead(160);
    const u = state.gymUsers.find((x) => x.id === member_id);
    if (!u) return false;
    const current = getCurrentCycleEntry(u);
    if (!current) return true;
    return current.status !== "settled" || current.liquidated_amount < current.invoiced_amount;
  },
  /**
   * Settle a member's cycle. Pre-flight freshness ping → optimistic write →
   * simulated round-trip → rollback to snapshot on network desync.
   */
  markMemberPaid: async (
    id: string,
    method: PaymentMethod = "cash",
    action_idempotency_key?: string,
  ): Promise<boolean> => {
    const u = state.gymUsers.find((x) => x.id === id);
    if (!u) return false;
    // Double-spend lock: a replayed click must never mint a phantom cycle.
    if (action_idempotency_key && !claimIdempotencyKey(action_idempotency_key)) return false;

    const fresh = await store.verifyMemberFreshness(id);
    if (!fresh) {
      await store.fetchGlobalTelemetry(); // auto-refresh the stale row
      toast.error("CYCLE ALREADY SETTLED", {
        description: "A gateway webhook cleared this member. Row refreshed.",
      });
      return false;
    }
    const snapshot = snapshotState(state); // deep-cloned rollback anchor
    const p = getPackage(state, u.package_id);
    const amount = p?.price ?? 0;
    const current = getCurrentCycleEntry(u);
    const start = calendarToday();
    const history =
      current && current.status !== "settled"
        ? u.subscription_history.map((l) =>
            l.id === current.id
              ? {
                  ...l,
                  status: "settled" as TransactionStatus,
                  liquidated_amount: Math.round(amount),
                  payment_method: method,
                  version_lock: l.version_lock + 1,
                }
              : l,
          )
        : [
            ...u.subscription_history,
            {
              id: uuid(),
              user_id: u.id,
              package_id: u.package_id,
              package_name: p?.name ?? "—",
              invoiced_amount: Math.round(amount),
              liquidated_amount: Math.round(amount),
              billing_period_start: start,
              billing_period_end: addCalendarDays(start, p?.duration_days ?? 30),
              status: "settled" as TransactionStatus,
              idempotency_key: uuid(),
              version_lock: 1,
              payment_method: method,
            },
          ];
    state = {
      ...state,
      gymUsers: state.gymUsers.map((x) => (x.id === id ? { ...x, subscription_history: history } : x)),
    };
    pushActivity({
      memberId: id,
      kind: "payment",
      message: `${u.full_name} marked paid (${method === "cash" ? "Cash" : method}) — Rs. ${amount.toLocaleString("en-PK")}`,
    });
    emit(); // optimistic paint

    try {
      await simulateApiCall();
      return true;
    } catch {
      state = snapshot; // zero ghost data
      emit();
      toast.error("NETWORK DESYNC: Settlement Failed", {
        description: "The payment was rolled back. Nothing was committed.",
      });
      return false;
    }
  },
  deactivateMember: (id: string) => {
    const u = state.gymUsers.find((x) => x.id === id);
    if (!u) return;
    state = {
      ...state,
      gymUsers: state.gymUsers.map((x) =>
        x.id === id ? { ...x, lifecycle_status: "inactive" as const } : x,
      ),
    };
    pushActivity({
      memberId: id,
      kind: "member_deactivated",
      message: `${u.full_name}'s package expired. Moved to inactive.`,
    });
    emit();
  },
  reactivateMember: (id: string) => {
    state = {
      ...state,
      gymUsers: state.gymUsers.map((x) =>
        x.id === id ? { ...x, lifecycle_status: "active" as const } : x,
      ),
    };
    emit();
  },
  /** Membership freeze / pause — pushes the computed expiry forward. */
  accrueSuspension: (id: string, days: number) => {
    const u = state.gymUsers.find((x) => x.id === id);
    if (!u) return;
    state = {
      ...state,
      gymUsers: state.gymUsers.map((x) =>
        x.id === id
          ? { ...x, suspension_days_accrued: (x.suspension_days_accrued ?? 0) + days }
          : x,
      ),
    };
    pushActivity({
      memberId: id,
      kind: "status",
      message: `${u.full_name}'s membership paused for ${days} days`,
    });
    emit();
  },
  updateTaskQueueConfig: (patch: Partial<TaskQueueConfig>) => {
    state = { ...state, taskQueueConfig: { ...state.taskQueueConfig, ...patch } };
    emit();
  },
  updateIntegrations: <K extends keyof IntegrationsConfig>(
    key: K,
    patch: Partial<IntegrationsConfig[K]>,
  ) => {
    state = {
      ...state,
      integrations: {
        ...state.integrations,
        [key]: { ...state.integrations[key], ...patch },
      },
    };
    emit();
  },
  triggerReminder: (id: string) => {
    const u = state.gymUsers.find((x) => x.id === id);
    if (!u) return;
    pushActivity({
      memberId: id,
      kind: "whatsapp",
      message: `Auto-reminder queued to Meta API for ${u.full_name}`,
    });
    emit();
  },
  /** Queues a WhatsApp payload for every unpaid member on the active node. */
  dispatchBulkReminders: (): number => {
    const targets = state.gymUsers.filter((u) => {
      const p = getPackage(state, u.package_id);
      return getMemberStatus(u, p) === "UNPAID";
    });
    targets.forEach((u) =>
      pushActivity({
        memberId: u.id,
        kind: "whatsapp",
        message: `Bulk reminder queued to Meta API for ${u.full_name}`,
      }),
    );
    if (targets.length > 0) {
      pushActivity({
        kind: "system",
        message: `Bulk dispatch executed — ${targets.length} reminder payloads staged`,
      });
    }
    emit();
    return targets.length;
  },
  addStudent: (s: Omit<Student, "id" | "status">) => {
    state = { ...state, students: [...state.students, { ...s, id: uuid(), status: "UNPAID" }] };
    emit();
  },
};

export function useStore<T>(selector: (s: StoreView) => T): T {
  return useSyncExternalStore(
    store.subscribe,
    () => selector(view(state)),
    () => selector(view(initial)),
  );
}


/**
 * Stands in for the SQL aggregate behind `store.fetchGlobalTelemetry()`.
 * Lives outside the store so no component can accidentally call it and
 * re-introduce browser-side global math over a paginated table.
 */
function aggregateGymRows(s: State): Omit<GymTelemetryKpis, "synced_at" | "is_syncing" | "isLoadingTelemetry"> {
  let collected = 0;
  let invoiced = 0;
  let mrr = 0;
  let active = 0;
  let expiring = 0;
  let inactive = 0;
  const soon = addCalendarDays(calendarToday(), 7);
  for (const u of s.gymUsers) {
    if (u.lifecycle_status === "inactive") inactive += 1;
    else active += 1;
    const p = getPackage(s, u.package_id);
    if (p && u.lifecycle_status === "active") {
      mrr += Math.round((p.price / Math.max(1, p.duration_days)) * 30);
    }
    const current = getCurrentCycleEntry(u);
    if (current && parseCalendarDate(current.billing_period_end) <= parseCalendarDate(soon)) {
      expiring += 1;
    }
    for (const l of u.subscription_history) {
      invoiced += l.invoiced_amount;
      collected += l.liquidated_amount;
    }
  }
  const total = active + inactive;
  return {
    mrr: Math.round(mrr),
    collected: Math.round(collected),
    outstanding: Math.max(0, Math.round(invoiced - collected)),
    active_members: active,
    expiring_soon: expiring,
    churn_rate: total ? Math.round((inactive / total) * 1000) / 10 : 0,
  };
}
